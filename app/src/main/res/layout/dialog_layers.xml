<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar Capa Satelital"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/radioGroupLayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbOsm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenStreetMap (Topográfico)"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbEsri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esri World Imagery (Satélite)"/>

        <RadioButton
            android:id="@+id/rbUsgs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USGS Topo (Global)"/>

        <RadioButton
            android:id="@+id/rbMicrosoft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Microsoft Planetary Computer / Satélite"/>

    </RadioGroup>

</LinearLayout>